# Copy this file to .env and provide your own key.
OPENAI_API_KEY=

# Model and retrieval configuration
CHAT_MODEL=gpt-4o-mini
QNA_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
DRAFTING_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
TOP_K=6
MIN_SIMILARITY=0.61
DRAFTING_MAX_DISTANCE=0.75
ANONYMIZED_TELEMETRY=False
MAX_QUESTION_LENGTH=1000
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
LOG_LEVEL=INFO
QUERY_INSTRUCTION=Represent this sentence for searching relevant passages:

# Root containing the checked-in prototype Chroma indexes.
CHROMA_ROOT=Data/Vector DataBase

# API, frontend, and local interaction history
EPLC_API_URL=http://localhost:8000
STATE_DATABASE=var/eplc_assistant.sqlite3
CORS_ORIGINS=http://localhost:8501
